# CBT uses its own Firebase project, separate from Classfolio's Netlify Database.
CBT_FIREBASE_PROJECT_ID=your-dedicated-cbt-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repository\cbt-service-account.json
CBT_PORT=3001
CBT_ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-characters-long
CBT_ALLOWED_ORIGINS=http://localhost:3000
CBT_EXAM_DURATION_SECONDS=1800

# Leave empty for local development (Vite proxies /api to the CBT service).
# Set to the deployed CBT API origin when deploying the frontend.
VITE_CBT_API_URL=
